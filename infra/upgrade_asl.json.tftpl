{
  "Comment": "TeamCity ECS major-upgrade orchestrator (OUTSIDE the instance being upgraded). BackupRDS (skippable) → Wait → DrainBuildsAndAgents → Deploy → WaitMaintenanceOrBoot → ConfirmMaintenanceUpgrade → WaitDbConversion → PollTeamCityReady; Catch → Rollback (task-def; RDS restore is manual/optional).",
  "StartAt": "BackupRDSChoice",
  "States": {
    "BackupRDSChoice": {
      "Type": "Choice",
      "Comment": "Skip RDS snapshot when rdsDbInstanceIdentifier is empty",
      "Choices": [
        {
          "Variable": "$.rdsDbInstanceIdentifier",
          "StringEquals": "",
          "Next": "WaitBeforeDrain"
        },
        {
          "Variable": "$.skipRdsBackup",
          "BooleanEquals": true,
          "Next": "WaitBeforeDrain"
        }
      ],
      "Default": "BackupRDS"
    },
    "BackupRDS": {
      "Type": "Task",
      "Comment": "CodeBuild: optional RDS create-db-snapshot (REQUIRED before major jump — downgrade after conversion needs restore)",
      "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Parameters": {
        "ProjectName": "${backup_project_name}",
        "EnvironmentVariablesOverride": [
          {
            "Name": "RDS_DB_ID",
            "Type": "PLAINTEXT",
            "Value.$": "$.rdsDbInstanceIdentifier"
          }
        ]
      },
      "ResultPath": "$.backupResult",
      "Next": "WaitBeforeDrain",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "FailBackup"
        }
      ]
    },
    "WaitBeforeDrain": {
      "Type": "Wait",
      "Comment": "Maintenance-window padding before drain/deploy",
      "Seconds": ${wait_seconds},
      "Next": "DrainBuildsAndAgents"
    },
    "DrainBuildsAndAgents": {
      "Type": "Task",
      "Comment": "Preflight: poll TC REST until running builds==0; disable agents / scale agent compute to 0. MUST pass before Deploy.",
      "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Parameters": {
        "ProjectName": "${drain_project_name}",
        "EnvironmentVariablesOverride": [
          {
            "Name": "TEAMCITY_BASE_URL",
            "Type": "PLAINTEXT",
            "Value.$": "$.teamcityBaseUrl"
          }
        ]
      },
      "ResultPath": "$.drainResult",
      "Next": "Deploy",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "Rollback"
        }
      ]
    },
    "Deploy": {
      "Type": "Task",
      "Comment": "CodeBuild: stop-before-start ECS deploy of new TeamCity image/task def",
      "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Parameters": {
        "ProjectName": "${deploy_project_name}"
      },
      "ResultPath": "$.deployResult",
      "Next": "WaitMaintenanceOrBoot",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "Rollback"
        }
      ]
    },
    "WaitMaintenanceOrBoot": {
      "Type": "Task",
      "Comment": "Poll until maintenance page OR REST version matches target (major jumps enter Maintenance Mode)",
      "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Parameters": {
        "ProjectName": "${poll_project_name}",
        "EnvironmentVariablesOverride": [
          {
            "Name": "TEAMCITY_BASE_URL",
            "Type": "PLAINTEXT",
            "Value.$": "$.teamcityBaseUrl"
          },
          {
            "Name": "TARGET_TC_VERSION",
            "Type": "PLAINTEXT",
            "Value.$": "$.targetTcVersion"
          },
          {
            "Name": "ACCEPT_MAINTENANCE",
            "Type": "PLAINTEXT",
            "Value": "1"
          },
          {
            "Name": "REQUIRE_VERSION",
            "Type": "PLAINTEXT",
            "Value": "0"
          },
          {
            "Name": "POLL_TIMEOUT_SEC",
            "Type": "PLAINTEXT",
            "Value": "${poll_boot_timeout_sec}"
          }
        ]
      },
      "ResultPath": "$.waitMaintenanceResult",
      "Next": "ConfirmMaintenanceUpgrade",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "Rollback"
        }
      ]
    },
    "ConfirmMaintenanceUpgrade": {
      "Type": "Task",
      "Comment": "Read Super user/maintenance token from CloudWatch logs and HTTP POST the maintenance form (no official REST API). No-ops if already at target version.",
      "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Parameters": {
        "ProjectName": "${confirm_project_name}",
        "EnvironmentVariablesOverride": [
          {
            "Name": "TEAMCITY_BASE_URL",
            "Type": "PLAINTEXT",
            "Value.$": "$.teamcityBaseUrl"
          },
          {
            "Name": "TARGET_TC_VERSION",
            "Type": "PLAINTEXT",
            "Value.$": "$.targetTcVersion"
          },
          {
            "Name": "LOG_GROUP",
            "Type": "PLAINTEXT",
            "Value.$": "$.teamcityLogGroup"
          }
        ]
      },
      "ResultPath": "$.confirmResult",
      "Next": "WaitDbConversion",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "Rollback"
        }
      ]
    },
    "WaitDbConversion": {
      "Type": "Task",
      "Comment": "Long poll: maintenance gone AND REST version == target (DB/data conversion; 60–120 min typical)",
      "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Parameters": {
        "ProjectName": "${wait_db_project_name}",
        "EnvironmentVariablesOverride": [
          {
            "Name": "TEAMCITY_BASE_URL",
            "Type": "PLAINTEXT",
            "Value.$": "$.teamcityBaseUrl"
          },
          {
            "Name": "TARGET_TC_VERSION",
            "Type": "PLAINTEXT",
            "Value.$": "$.targetTcVersion"
          },
          {
            "Name": "POLL_TIMEOUT_SEC",
            "Type": "PLAINTEXT",
            "Value": "${wait_db_timeout_sec}"
          }
        ]
      },
      "ResultPath": "$.waitDbResult",
      "Next": "PollTeamCityReady",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "Rollback"
        }
      ]
    },
    "PollTeamCityReady": {
      "Type": "Task",
      "Comment": "Final assert: /app/rest/server reports target version (REQUIRE_VERSION=1)",
      "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Parameters": {
        "ProjectName": "${poll_project_name}",
        "EnvironmentVariablesOverride": [
          {
            "Name": "TEAMCITY_BASE_URL",
            "Type": "PLAINTEXT",
            "Value.$": "$.teamcityBaseUrl"
          },
          {
            "Name": "TARGET_TC_VERSION",
            "Type": "PLAINTEXT",
            "Value.$": "$.targetTcVersion"
          },
          {
            "Name": "ACCEPT_MAINTENANCE",
            "Type": "PLAINTEXT",
            "Value": "0"
          },
          {
            "Name": "REQUIRE_VERSION",
            "Type": "PLAINTEXT",
            "Value": "1"
          },
          {
            "Name": "POLL_TIMEOUT_SEC",
            "Type": "PLAINTEXT",
            "Value": "${poll_ready_timeout_sec}"
          }
        ]
      },
      "ResultPath": "$.pollReadyResult",
      "Next": "UpgradeSucceeded",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "Rollback"
        }
      ]
    },
    "Rollback": {
      "Type": "Task",
      "Comment": "Catch path: restore previous ECS task definition. NOTE: after DB conversion, task-def rollback alone is insufficient — restore RDS/EFS from pre-upgrade snapshot separately (manual/optional state).",
      "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Parameters": {
        "ProjectName": "${rollback_project_name}",
        "EnvironmentVariablesOverride": [
          {
            "Name": "PREVIOUS_TASK_DEFINITION_ARN",
            "Type": "PLAINTEXT",
            "Value.$": "$.previousTaskDefinitionArn"
          }
        ]
      },
      "ResultPath": "$.rollbackResult",
      "Next": "FailAfterRollback",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.rollbackError",
          "Next": "FailRollbackAlsoFailed"
        }
      ]
    },
    "UpgradeSucceeded": {
      "Type": "Succeed",
      "Comment": "Major upgrade confirmed; DB conversion complete; target version verified"
    },
    "FailBackup": {
      "Type": "Fail",
      "Error": "BackupFailed",
      "Cause": "RDS backup / snapshot step failed before deploy"
    },
    "FailAfterRollback": {
      "Type": "Fail",
      "Error": "UpgradeFailedRolledBack",
      "Cause": "Deploy/confirm/wait/poll failed; ECS task-def rollback was attempted. If conversion started, restore RDS/EFS from snapshot manually."
    },
    "FailRollbackAlsoFailed": {
      "Type": "Fail",
      "Error": "UpgradeAndRollbackFailed",
      "Cause": "Upgrade path failed and task-def rollback also failed — manual intervention required"
    }
  }
}
